{
  "format": 1,
  "module": "registry",
  "cases": [
    {
      "op": "make_carrier_id",
      "name": "external plain path",
      "input": {
        "carrier_type": "external_object",
        "subject": "src/a.py"
      },
      "expected": "external_object:src/a.py"
    },
    {
      "op": "make_carrier_id",
      "name": "external /testbed/ prefix and whitespace",
      "input": {
        "carrier_type": "external_object",
        "subject": "  /testbed/src/a.py \n"
      },
      "expected": "external_object:src/a.py"
    },
    {
      "op": "make_carrier_id",
      "name": "external ./ prefix, double slash and ..",
      "input": {
        "carrier_type": "external_object",
        "subject": "./src//b/../a.py"
      },
      "expected": "external_object:src/a.py"
    },
    {
      "op": "make_carrier_id",
      "name": "external trailing slash and .",
      "input": {
        "carrier_type": "external_object",
        "subject": "a/./b/"
      },
      "expected": "external_object:a/b"
    },
    {
      "op": "make_carrier_id",
      "name": "external absolute path",
      "input": {
        "carrier_type": "external_object",
        "subject": "/abs/x/../path.py"
      },
      "expected": "external_object:/abs/path.py"
    },
    {
      "op": "make_carrier_id",
      "name": "external leading double slash is kept",
      "input": {
        "carrier_type": "external_object",
        "subject": "//net/share"
      },
      "expected": "external_object://net/share"
    },
    {
      "op": "make_carrier_id",
      "name": "external triple slash collapses",
      "input": {
        "carrier_type": "external_object",
        "subject": "///x/y"
      },
      "expected": "external_object:/x/y"
    },
    {
      "op": "make_carrier_id",
      "name": "external leading .. is kept",
      "input": {
        "carrier_type": "external_object",
        "subject": "../up/x.py"
      },
      "expected": "external_object:../up/x.py"
    },
    {
      "op": "make_carrier_id",
      "name": ".. above an absolute root is dropped",
      "input": {
        "carrier_type": "external_object",
        "subject": "/../a"
      },
      "expected": "external_object:/a"
    },
    {
      "op": "make_carrier_id",
      "name": "external empty subject",
      "input": {
        "carrier_type": "external_object",
        "subject": "   "
      },
      "expected": "external_object:."
    },
    {
      "op": "make_carrier_id",
      "name": "external only /testbed/",
      "input": {
        "carrier_type": "external_object",
        "subject": "/testbed/"
      },
      "expected": "external_object:."
    },
    {
      "op": "make_carrier_id",
      "name": "information product collapses whitespace",
      "input": {
        "carrier_type": "information_product",
        "subject": "  Root   cause\n of\tbug "
      },
      "expected": "information_product:Root cause of bug"
    },
    {
      "op": "make_carrier_id",
      "name": "situated state collapses whitespace",
      "input": {
        "carrier_type": "situated_state",
        "subject": "branch\t main"
      },
      "expected": "situated_state:branch main"
    },
    {
      "op": "materialize",
      "name": "new carriers start at version 1",
      "input": {
        "store": [],
        "edits": [
          {
            "candidate_id": "C1",
